{
  "name": "@ielts-vocabs-app/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:user\" \"pnpm dev:admin\"",
    "dev:backend": "npx tsx --tsconfig apps/backend/tsconfig.json apps/backend/src/main.ts",
    "dev:user": "next dev apps/user --webpack --port 3000",
    "dev:admin": "next dev apps/admin --webpack --port 3001",
    "build": "nx run-many --target=build --projects=backend,user,admin",
    "build:backend": "nx build backend",
    "build:user": "nx build user",
    "build:admin": "nx build admin",
    "start": "concurrently \"pnpm start:backend\" \"pnpm start:user\" \"pnpm start:admin\"",
    "start:backend": "node dist/apps/backend/main.js",
    "start:user": "next start apps/user --port 3000",
    "start:admin": "next start apps/admin --port 3001",
    "seed": "npx tsx --tsconfig apps/backend/tsconfig.json apps/backend/src/seed.ts",
    "lint": "pnpm lint:check",
    "lint:check": "biome check .",
    "lint:fix": "pnpm lint:fix:all",
    "lint:backend": "biome check apps/backend",
    "lint:user": "biome check apps/user",
    "lint:admin": "biome check apps/admin",
    "lint:fix:backend": "biome check --write apps/backend",
    "lint:fix:user": "biome check --write apps/user",
    "lint:fix:admin": "biome check --write apps/admin",
    "lint:fix:all": "biome check --write apps",
    "test": "nx run-many --target=test --all",
    "clean": "nx reset && rm -rf dist node_modules"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@biomejs/biome": "^2.3.8",
    "@nx/express": "^22.1.3",
    "@nx/jest": "^22.1.3",
    "@nx/js": "22.1.3",
    "@nx/next": "^22.1.3",
    "@nx/node": "^22.1.3",
    "@nx/react": "^22.1.3",
    "@nx/web": "22.1.3",
    "@nx/webpack": "22.1.3",
    "@nx/workspace": "22.1.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "nx": "22.1.3",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "react-refresh": "^0.10.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@chakra-ui/next-js": "^2.4.2",
    "@chakra-ui/react": "^2.10.4",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.12",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^11.11.17",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.556.0",
    "mongoose": "^9.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "next": "~16.0.1",
    "nodemailer": "^7.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.1",
    "winston": "^3.19.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  }
}
